    "m_FunctionBody": "float2 w = WorldPos.xz;\nw += TimeValue * FlowSpeed * float2(0.7, 0.3);\nfloat2 g = floor(w / max(BlockSize, 0.0001)) * BlockSize;\nfloat2 uv = g / max(PatternScale, 0.0001);\nfloat2 ip = floor(uv);\nfloat2 fp = frac(uv);\nfp = fp * fp * (3.0 - 2.0 * fp);\nfloat a = frac(sin(dot(ip + float2(0.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat b = frac(sin(dot(ip + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat c = frac(sin(dot(ip + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat d = frac(sin(dot(ip + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n = lerp(lerp(a, b, fp.x), lerp(c, d, fp.x), fp.y);\nfloat2 uv2 = uv * 2.17;\nfloat2 ip2 = floor(uv2);\nfloat2 fp2 = frac(uv2);\nfp2 = fp2 * fp2 * (3.0 - 2.0 * fp2);\nfloat a2 = frac(sin(dot(ip2 + float2(0.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat b2 = frac(sin(dot(ip2 + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat c2 = frac(sin(dot(ip2 + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat d2 = frac(sin(dot(ip2 + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n2 = lerp(lerp(a2, b2, fp2.x), lerp(c2, d2, fp2.x), fp2.y);\nn = n * 0.65 + n2 * 0.35;\nfloat levels = max(floor(ColorLevels), 2.0);\nfloat q = min(floor(saturate(n) * levels), levels - 1.0);\nn = q / (levels - 1.0);\nfloat s = saturate(n) * 3.0;\nfloat3 col;\nif (s < 1.0) { col = lerp(CoolColor, MidColor, s); }\nelse if (s < 2.0) { col = lerp(MidColor, HotColor, s - 1.0); }\nelse { col = lerp(HotColor, PeakColor, s - 2.0); }\nBaseColor = col;\nEmission = col * EmissionColor * (EmissionStrength * saturate(n + 0.1));"
}

