{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "fedcba9876543210fedcba9876543210",
    "m_Group": { "m_Id": "" },
    "m_Name": "Puddle (Custom Function)",
    "m_DrawState": { "m_Expanded": true, "m_Position": { "serializedVersion": "2", "x": -420.0, "y": 0.0, "width": 280.0, "height": 420.0 } },
    "m_Slots": [
        { "m_Id": "fedcba9876543210fedcba9876543211" },
        { "m_Id": "fedcba9876543210fedcba9876543212" },
        { "m_Id": "fedcba9876543210fedcba9876543213" },
        { "m_Id": "fedcba9876543210fedcba9876543214" },
        { "m_Id": "fedcba9876543210fedcba9876543215" },
        { "m_Id": "fedcba9876543210fedcba9876543216" },
        { "m_Id": "fedcba9876543210fedcba9876543217" },
        { "m_Id": "fedcba9876543210fedcba9876543218" },
        { "m_Id": "fedcba9876543210fedcba9876543219" },
        { "m_Id": "fedcba9876543210fedcba987654321a" },
        { "m_Id": "fedcba9876543210fedcba987654321b" },
        { "m_Id": "fedcba9876543210fedcba987654321c" },
        { "m_Id": "fedcba9876543210fedcba987654321d" },
        { "m_Id": "fedcba9876543210fedcba987654321e" }
    ],
    "synonyms": [ "code", "HLSL" ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": { "m_SerializableColors": [] },
    "m_SourceType": 1,
    "m_FunctionName": "Puddle",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 uv = UV;\nfloat2 puv = floor(uv / max(BlockSize, 0.0001)) * BlockSize;\nfloat2 dvec = puv - 0.5;\nfloat dist = length(dvec);\nfloat ang = atan2(dvec.y, dvec.x);\nfloat wob = 0.0;\nwob += sin(ang * (2.0 + floor(NoiseScale)) + Seed * 6.2831) * 0.6;\nwob += sin(ang * (4.0 + floor(NoiseScale)) - Seed * 3.1) * 0.3;\nwob += sin(ang * (7.0 + floor(NoiseScale)) + Seed * 1.7) * 0.15;\nfloat r = Radius * (1.0 + wob * EdgeNoise);\nfloat inside = step(dist, r);\nfloat rim = inside * step(r - RimWidth, dist);\nfloat2 nuv = puv * 7.0 + Seed * 12.0;\nfloat2 ip = floor(nuv);\nfloat2 fp = frac(nuv);\nfp = fp * fp * (3.0 - 2.0 * fp);\nfloat a = frac(sin(dot(ip + float2(0.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat b = frac(sin(dot(ip + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat c = frac(sin(dot(ip + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat d = frac(sin(dot(ip + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n = lerp(lerp(a, b, fp.x), lerp(c, d, fp.x), fp.y);\nfloat3 fill = lerp(InteriorA, InteriorB, n);\nfloat3 col = lerp(fill, RimColor, rim);\nBaseColor = col;\nAlpha = inside;\nEmission = col * EmissionStrength * (1.0 - rim) * inside;"
}

